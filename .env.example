# ==============================================================================
# EPUB to M4B Studio Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Contextual Normalizer (Tùy chọn: Chuẩn hoá ngữ cảnh & giải mã điểm nghi vấn)
# Hỗ trợ: OpenAI, Gemini, DeepSeek, Groq, Ollama hoặc bất kỳ OpenAI-compatible API nào
# ------------------------------------------------------------------------------
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Audiobookshelf (ABS) Integration (Server Homelab i3-6100)
# ------------------------------------------------------------------------------
# Địa chỉ máy chủ Audiobookshelf trong mạng LAN hoặc domain (kèm port)
ABS_URL=http://192.168.1.100:13378

# API Token lấy từ ABS: Settings -> Users -> Chọn user -> Create API Token
ABS_TOKEN=your_abs_api_token_here

# ID Thư viện sách nói trong Audiobookshelf (để trống nếu muốn bot tự tìm thư viện đầu tiên)
ABS_LIBRARY_ID=

# (Tùy chọn) Thư mục mount thư viện ABS nếu máy PC share ổ đĩa với server i3-6100 (SMB/NFS)
# Ví dụ trên Windows: \\192.168.1.100\audiobooks  | Trên Linux: /mnt/audiobooks
ABS_STORAGE_PATH=

# Tự động scan thư viện ABS sau khi copy/upload file .m4b (true/false)
ABS_AUTO_SCAN=true

# ------------------------------------------------------------------------------
# 3. Hardware & Performance Options
# ------------------------------------------------------------------------------
# Batch size cho GPU VieNeu (mặc định tự nhận diện theo VRAM: 8 trên RTX 3060 12GB, 1 trên CPU)
# TTS_BATCH_SIZE=8
